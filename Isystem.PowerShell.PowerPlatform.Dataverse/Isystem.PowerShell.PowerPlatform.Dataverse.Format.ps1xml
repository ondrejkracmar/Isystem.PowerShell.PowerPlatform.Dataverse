<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>DataverseConnectionInfo</Name>
      <ViewSelectedBy>
        <TypeName>Isystem.PowerShell.PowerPlatform.Dataverse.Models.DataverseConnectionInfo</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem><PropertyName>IsConnected</PropertyName></ListItem>
              <ListItem><PropertyName>OrganizationUrl</PropertyName></ListItem>
              <ListItem><PropertyName>OrganizationFriendlyName</PropertyName></ListItem>
              <ListItem><PropertyName>EnvironmentId</PropertyName></ListItem>
              <ListItem><PropertyName>AuthenticationType</PropertyName></ListItem>
              <ListItem><PropertyName>Identity</PropertyName></ListItem>
              <ListItem><PropertyName>UserId</PropertyName></ListItem>
              <ListItem><PropertyName>HasTokenCache</PropertyName></ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>
    <View>
      <Name>DataverseBatchResult</Name>
      <ViewSelectedBy>
        <TypeName>Isystem.PowerShell.PowerPlatform.Dataverse.Models.DataverseBatchResult</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Total</Label><Width>7</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Succeeded</Label><Width>10</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Failed</Label><Width>7</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>IsFullSuccess</Label><Width>14</Width></TableColumnHeader>
          <TableColumnHeader><Label>Errors</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>TotalRequests</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>SuccessCount</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>FailureCount</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>IsFullSuccess</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>if ($_.Errors) { $_.Errors -join '; ' }</ScriptBlock></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>DataverseBatchItemResult</Name>
      <ViewSelectedBy>
        <TypeName>Isystem.PowerShell.PowerPlatform.Dataverse.Models.DataverseBatchItemResult</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Index</Label><Width>5</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Action</Label><Width>7</Width></TableColumnHeader>
          <TableColumnHeader><Label>LogicalName</Label><Width>24</Width></TableColumnHeader>
          <TableColumnHeader><Label>Id</Label><Width>36</Width></TableColumnHeader>
          <TableColumnHeader><Label>Succeeded</Label><Width>9</Width></TableColumnHeader>
          <TableColumnHeader><Label>Created</Label><Width>7</Width></TableColumnHeader>
          <TableColumnHeader><Label>ErrorCode</Label><Width>11</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Message</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Index</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Action</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>LogicalName</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Id</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Succeeded</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>RecordCreated</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>ErrorCode</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Message</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>DataverseUpsertResult</Name>
      <ViewSelectedBy>
        <TypeName>Isystem.PowerShell.PowerPlatform.Dataverse.Models.DataverseUpsertResult</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>LogicalName</Label><Width>24</Width></TableColumnHeader>
          <TableColumnHeader><Label>Id</Label><Width>36</Width></TableColumnHeader>
          <TableColumnHeader><Label>RecordCreated</Label><Width>13</Width></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>LogicalName</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Id</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>RecordCreated</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>DataverseTableInfo</Name>
      <ViewSelectedBy>
        <TypeName>Isystem.PowerShell.PowerPlatform.Dataverse.Models.DataverseTableInfo</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>LogicalName</Label><Width>34</Width></TableColumnHeader>
          <TableColumnHeader><Label>DisplayName</Label><Width>28</Width></TableColumnHeader>
          <TableColumnHeader><Label>PrimaryId</Label><Width>26</Width></TableColumnHeader>
          <TableColumnHeader><Label>PrimaryName</Label><Width>26</Width></TableColumnHeader>
          <TableColumnHeader><Label>Custom</Label><Width>7</Width></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>LogicalName</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>DisplayName</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>PrimaryIdAttribute</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>PrimaryNameAttribute</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>IsCustomEntity</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>DataverseColumnInfo</Name>
      <ViewSelectedBy>
        <TypeName>Isystem.PowerShell.PowerPlatform.Dataverse.Models.DataverseColumnInfo</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>LogicalName</Label><Width>34</Width></TableColumnHeader>
          <TableColumnHeader><Label>Type</Label><Width>14</Width></TableColumnHeader>
          <TableColumnHeader><Label>Required</Label><Width>18</Width></TableColumnHeader>
          <TableColumnHeader><Label>Create</Label><Width>7</Width></TableColumnHeader>
          <TableColumnHeader><Label>Update</Label><Width>7</Width></TableColumnHeader>
          <TableColumnHeader><Label>DisplayName</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>LogicalName</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>AttributeType</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>RequiredLevel</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>IsValidForCreate</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>IsValidForUpdate</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>DisplayName</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>DataverseKeyInfo</Name>
      <ViewSelectedBy>
        <TypeName>Isystem.PowerShell.PowerPlatform.Dataverse.Models.DataverseKeyInfo</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>LogicalName</Label><Width>32</Width></TableColumnHeader>
          <TableColumnHeader><Label>IndexStatus</Label><Width>13</Width></TableColumnHeader>
          <TableColumnHeader><Label>KeyAttributes</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>LogicalName</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>IndexStatus</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>$_.KeyAttributes -join ', '</ScriptBlock></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
  </ViewDefinitions>
</Configuration>
